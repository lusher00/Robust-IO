         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCP5183 - High Voltage High Current High and Low Side Driver</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCP5183 is a High Voltage High Current Power MOSFET&#xD;&#xA;Driver providing two outputs for direct drive of 2 Nâˆ’channel power&#xD;&#xA;MOSFETs arranged in a halfâˆ’bridge (or any other highâˆ’side +&#xD;&#xA;lowâˆ’side) configuration.&#xD;&#xA;It uses the bootstrap technique to insure a proper drive of the&#xD;&#xA;Highâˆ’side power switch. The driver works with 2 independent inputs&#xD;&#xA;to accommodate any topology (including halfâˆ’bridge, asymmetrical&#xD;&#xA;halfâˆ’bridge, active clamp and fullâˆ’bridgeâ€¦).</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreateDate>2019-04-16T10:05:04-07:00</xmp:CreateDate>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2020-08-25T09:21:13+02:00</xmp:ModifyDate>
         <xmp:MetadataDate>2020-08-25T09:21:13+02:00</xmp:MetadataDate>
