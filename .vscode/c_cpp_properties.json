{
    "version": 4,
    "configurations": [
        {
            "name": "AVR ATmega1284P",
            "compilerPath": "/usr/local/bin/avr-gcc",
            "compilerArgs": ["-mmcu=atmega1284p"],
            "intelliSenseMode": "gcc-x86",
            "cStandard": "gnu11",
            "includePath": ["${workspaceFolder}/firmware/src"],
            "defines": [
                "__AVR_ATmega1284P__",
                "F_CPU=12000000UL",
                "FW_VERSION=\"vscode\""
            ]
        }
    ]
}
